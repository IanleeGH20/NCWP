    given-names: GangHo
    affiliation: "AI Graduate School, Gwangju Institute of Science and Technology"
  - family-names: Lee
    given-names: Yong-Gu
    affiliation: "AI Graduate School, Gwangju Institute of Science and Technology"
license: MIT
repository-code: "https://github.com/IanleeGH20/NCWP"
keywords:
  - sentence embeddings
  - retrieval
  - whitening
  - contrastive learning
  - large language models
